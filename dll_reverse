class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None
class DoublyLinkedList:
    def __init__(self):
        self.head = None
    def insert_end(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            return
        temp = self.head
        while temp.next is not None:
            temp = temp.next
        temp.next = new_node
        new_node.prev = temp
    def reverse(self):
        temp = self.head
        previous = None
        while temp is not None:
            previous = temp.prev
            temp.prev = temp.next
            temp.next = previous
            temp = temp.prev
        if previous is not None:
            self.head = previous.prev
    def display(self):
        temp = self.head
        print("List:", end=" ")
        while temp is not None:
            print(temp.data, end=" ")
            temp = temp.next
        print()
dll = DoublyLinkedList()
dll.insert_end(10)
dll.insert_end(20)
dll.insert_end(30)
dll.insert_end(40)
print("Original list:")
dll.display()
dll.reverse()
print("Reversed list:")
dll.display()

